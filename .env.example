# Todas as variaveis abaixo sao opcionais: o projeto roda sem nenhuma delas.
# Para ajustes de limite e resolucao, prefira settings_local.json.

# Caminho para pesos proprios (padrao: yolov8n-pose.pt, baixado automaticamente)
EPI_MODEL_PATH=

# Porta do servidor web
EPI_PORT=5000

# Aceleracao OpenVINO em iGPU Intel. Exporte o modelo antes:
#   yolo export model=yolov8n-pose.pt format=openvino
EPI_USE_OPENVINO=0

# Limite de threads do PyTorch. Vazio ou 0 deixa a decisao para o PyTorch.
EPI_TORCH_THREADS=
